<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#faf6ee">
<title>Palak & Nalin — Invitation</title>
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{--ivory:#faf6ee;--warm:#fffdf8;--gold:#c2a15c;--goldDeep:#a5823f;--blush:#c97f87;--ink:#43403a}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--ivory);color:var(--ink)}
body{min-height:100svh;overflow:hidden}a{color:inherit;text-decoration:none}
.cover{min-height:100svh;display:grid;place-items:center;padding:24px;position:relative;overflow:hidden;background:
radial-gradient(700px 460px at 15% 15%,rgba(240,196,155,.30),transparent 62%),
radial-gradient(700px 460px at 85% 90%,rgba(227,167,173,.24),transparent 62%),var(--ivory)}
.cover::before,.cover::after{content:"";position:absolute;border:1px solid rgba(194,161,92,.38);pointer-events:none}
.cover::before{inset:16px}.cover::after{inset:22px;border-color:rgba(194,161,92,.18)}
.inner{position:relative;z-index:1;width:min(760px,92vw);padding:64px 30px;text-align:center;background:rgba(255,253,248,.72);border:1px solid rgba(194,161,92,.45);box-shadow:0 30px 90px rgba(90,72,40,.12);animation:rise 1s cubic-bezier(.22,1,.36,1) both}
.eyebrow{font:500 10px/1.4 Arial,sans-serif;letter-spacing:.34em;text-transform:uppercase;color:var(--goldDeep)}
.names{margin:28px 0 10px;font:500 clamp(64px,13vw,140px)/.82 "Cormorant Garamond",serif}
.weds{display:block;margin:14px 0;font:400 clamp(32px,5vw,56px) "Great Vibes",cursive;color:var(--blush)}
.open{margin-top:40px;font:400 clamp(32px,6vw,54px) "Great Vibes",cursive;color:var(--goldDeep)}
.date{margin-top:28px;font:500 11px/1.5 Arial,sans-serif;letter-spacing:.24em;text-transform:uppercase;color:var(--ink)}
.hint{margin-top:26px;font:500 9px/1 Arial,sans-serif;letter-spacing:.28em;text-transform:uppercase;color:#6f6a61}
.cover:hover .open{text-decoration:underline;text-decoration-color:rgba(194,161,92,.5);text-underline-offset:6px}
.is-leaving .inner{animation:out .55s ease forwards}
@keyframes rise{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}
@keyframes out{to{opacity:0;transform:translateY(-10px) scale(1.02)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head>
<body>
<a class="cover" id="coverLink" href="index.html#home">
  <div class="inner">
    <div class="eyebrow" id="eyebrow">Together with their families</div>
    <div class="names" id="names">Palak<span class="weds">weds</span>Nalin</div>
    <div class="open" id="openText">Click to Open Invite</div>
    <div class="date" id="date">Lucknow · 03 December 2026</div>
    <div class="hint">Tap anywhere</div>
  </div>
</a>
<script src="config.js"></script>
<script>
(function(){
  const cfg=window.INVITE_CONFIG||{};
  document.title=`${cfg.bride||'Palak'} & ${cfg.groom||'Nalin'} — Invitation`;
  document.getElementById('eyebrow').textContent=cfg.heroEyebrow||'Together with their families';
  document.getElementById('openText').textContent=cfg.openingText||'Click to Open Invite';
  document.getElementById('date').textContent=`${cfg.city||''} · ${cfg.dateLabel||''}`;
  const names=document.getElementById('names');
  names.innerHTML='';
  names.append(document.createTextNode(cfg.bride||'Palak'));
  const span=document.createElement('span'); span.className='weds'; span.textContent='weds';
  names.append(span, document.createTextNode(cfg.groom||'Nalin'));
  const link=document.getElementById('coverLink');
  link.addEventListener('click',function(e){
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault(); document.body.classList.add('is-leaving');
    setTimeout(()=>location.href=link.href,480);
  });
})();
</script>
</body></html>
